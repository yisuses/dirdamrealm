exports[`Home page > should prefetch the latest posts and render the page with its JSON-LD 1`] = `
<div>
  <script
    type="application/ld+json"
  >
    {"@context":"https://schema.org/","@type":"WebPage","headline":"Inicio","url":"https://example.com/"}
  </script>
  <pre
    data-testid="home-page"
  >
    [{"queryKey":["latestPosts","HomePage"],"data":[{"id":7,"title":"Hola Mundo"}]}]
  </pre>
</div>
`;
