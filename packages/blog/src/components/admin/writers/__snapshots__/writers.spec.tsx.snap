    >
      <div
        class="chakra-field__root css-13f87cb"
        data-part="root"
        data-scope="field"
        id="field::_r_d_"
        role="group"
      >
        <label
          class="chakra-field__label css-sqscs5"
          data-part="label"
          data-required=""
          data-scope="field"
          for="_r_d_"
          id="field::_r_d_::label"
        >
          Nombre
        </label>
        <input
          aria-describedby="field::_r_d_::helper-text"
          class="chakra-input css-1slcgpf"
          data-part="input"
          data-required=""
          data-scope="field"
          id="_r_d_"
          name="name"
          required=""
        />
        <span
          class="chakra-field__helperText css-ghvdt6"
          data-part="helper-text"
          data-scope="field"
          id="field::_r_d_::helper-text"
        >
          Tal y como aparece en las entradas.
        </span>
      </div>
      <div
        class="chakra-field__root css-13f87cb"
        data-part="root"
        data-scope="field"
        id="field::_r_e_"
        role="group"
      >
        <label
          class="chakra-field__label css-sqscs5"
          data-part="label"
          data-scope="field"
          for="_r_e_"
          id="field::_r_e_::label"
        >
          Usuario de Twitter / X
        </label>
        <input
          class="chakra-input css-1slcgpf"
          data-part="input"
          data-scope="field"
          id="_r_e_"
          name="twitter"
          placeholder="@usuario"
        />
      </div>
      <div
        class="chakra-field__root css-13f87cb"
        data-part="root"
        data-scope="field"
        id="field::_r_f_"
        role="group"
      >
        <label
          class="chakra-field__label css-sqscs5"
          data-part="label"
          data-scope="field"
          for="_r_f_"
          id="field::_r_f_::label"
        >
          Web personal
        </label>
        <input
          class="chakra-input css-1slcgpf"
          data-part="input"
          data-scope="field"
          id="_r_f_"
          name="personalUrl"
          placeholder="https://"
          type="url"
        />
      </div>
      <div
        class="chakra-field__root css-13f87cb"
        data-part="root"
        data-scope="field"
        id="field::_r_g_"
        role="group"
      >
        <label
          class="chakra-field__label css-sqscs5"
          data-part="label"
          data-scope="field"
          for="_r_g_"
          id="field::_r_g_::label"
        >
          Usuario del panel
        </label>
        <div
          class="chakra-native-select__root css-2z3u89"
        >
          <select
            aria-describedby="field::_r_g_::helper-text"
            class="chakra-native-select__field css-1b1q62i"
            data-part="select"
            data-scope="field"
            id="_r_g_"
            name="userId"
          >
            <option
              value=""
            >
              Ninguno
            </option>
            <option
              value="11111111-1111-4111-8111-111111111111"
            >
              José
            </option>
            <option
              value="22222222-2222-4222-8222-222222222222"
            >
              Saúl
            </option>
          </select>
          <div
            class="chakra-native-select__indicator css-1d5wz6j"
          >
            <svg
              class="css-s3mb0o"
              viewBox="0 0 24 24"
            >
              <path
                d="m6 9 6 6 6-6"
              />
            </svg>
          </div>
        </div>
        <span
          class="chakra-field__helperText css-ghvdt6"
          data-part="helper-text"
          data-scope="field"
          id="field::_r_g_::helper-text"
        >
          La persona que entra en el panel con esta firma.
        </span>
      </div>
      <div
        class="chakra-stack css-13ub2d7"
      >
        <button
          class="chakra-button css-5yp0ac"
          type="submit"
        >
          Guardar
        </button>
        <a
          class="chakra-button css-p0j63a"
          href="/admin/autores/"
          type="button"
        >
          Cancelar
        </a>
      </div>
    </div>
  </form>
</section>
`;

